<script type="text/javascript" src="https://www.dpd.com/wp-content/themes/DPD_NoLogin/js/master.min.js?ver=6.8.3" id="master-js"></script>
<script type="text/javascript" id="master-js-after">
/* <![CDATA[ */
            (function($){
                function enforceSingleOpen($root, $keepLi) {
                    if (!$root || !$root.length) return;
                    $root.find('> li.has-sub').not($keepLi || []).each(function () {
                        $(this).removeClass('active');
                        $(this).find('> .sub-expand').removeClass('active');
                        $(this).find('> a').removeClass('active');
                        $(this).find('> .sub').removeClass('opened').hide();
                    });
                }

                function collapseAllBurgerSubmenus() {
                    $('.offcanvas-content ul.burger-menu-desktop, .offcanvas-content ul.burger-menu-mobile').each(function () {
                        enforceSingleOpen($(this));
                    });
                }

                // Collapse accordion sections after opening, then restore current-page highlight
                // (collapseAllBurgerSubmenus strips .active from li.has-sub; sync reapplies it from URL).
                $(document).on('click', '.offmenu-toggle', function () {
                    setTimeout(function () {
                        collapseAllBurgerSubmenus();
                        if (typeof syncActiveMenuByUrl === 'function') {
                            syncActiveMenuByUrl();
                        }
                    }, 140);
                });

                // Any level-1 arrow click => keep only clicked section open.
                $(document).on('click', '.offcanvas-content li.has-sub > .sub-expand', function () {
                    var $li = $(this).closest('li.has-sub');
                    var $root = $li.closest('ul.burger-menu-desktop, ul.burger-menu-mobile');
                    setTimeout(function () {
                        enforceSingleOpen($root, $li);
                    }, 0);
                });

                // Guard against later async scripts reopening extra sections.
                $(document).on('click', '.offcanvas-content li.has-sub > .sub-expand, .offmenu-toggle', function () {
                    var $targetLi = $(this).closest('li.has-sub');
                    setTimeout(function () {
                        $('.offcanvas-content ul.burger-menu-desktop, .offcanvas-content ul.burger-menu-mobile').each(function () {
                            var $root = $(this);
                            var $opened = $root.children('li.has-sub').filter(function () {
                                return $(this).hasClass('active') || $(this).find('> .sub').hasClass('opened') || $(this).find('> .sub:visible').length > 0;
                            });
                            if ($opened.length <= 1) return;
                            var $keep = ($targetLi.length && $targetLi.closest('ul')[0] === $root[0]) ? $targetLi : $opened.last();
                            enforceSingleOpen($root, $keep);
                        });
                    }, 180);
                });
            })(jQuery);
        
/* ]]> */
</script>
