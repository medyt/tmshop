VITE_API_URL=/shoptop-api

# Obligatoriu exact VITE_API_URL (cu „URL”). Daca ai scris din greseala VITE_API_URI,
# codul accepta si varianta URI ca fallback, dar e mai bine sa corectezi aici.
# ID-uri pixel pentru tracking (se incarca doar cu consimtamant "Accept toate").
# Lasa gol pentru a dezactiva pixelul respectiv.
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
