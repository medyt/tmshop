VITE_API_URL=/shoptop-api

# Obligatoriu exact VITE_API_URL (cu „URL”). Daca ai scris din greseala VITE_API_URI,
# codul accepta si varianta URI ca fallback, dar e mai bine sa corectezi aici.
# ID-uri pixel pentru tracking.
# Meta Pixel e în HTML la build (fără consimțământ). TikTok + GA4 doar după „Accept toate”.
# Meta Pixel (Facebook) — ex: 2120556288842775
VITE_META_PIXEL_ID=2120556288842775
VITE_TIKTOK_PIXEL_ID=
# Google Analytics 4 — Measurement ID (G-XXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-15PV24R6TN

# Profitabilitate lunară — TVA România (21% = 0.21)
VITE_VAT_RATE=0.21
# Preț achiziție din gestiune include TVA (true) sau e deja fără TVA (false)
VITE_PURCHASE_PRICE_INCLUDES_VAT=true
