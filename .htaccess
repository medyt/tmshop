<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Sitemap dinamic
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Catalog Meta (Facebook / Instagram) — feed CSV pentru update automat
  RewriteRule ^catalog\.csv$ facebook-catalog.php [L]
  RewriteRule ^facebook-catalog\.csv$ facebook-catalog.php [L]

  # SEO shell: homepage + pagini produs (HTML cu conținut pentru crawleri)
  RewriteRule ^$ seo-shell.php [L]
  RewriteRule ^index\.html$ seo-shell.php [L]
  RewriteRule ^produs/([^/]+)/?$ seo-shell.php [L,QSA]

  RewriteRule ^shoptop-api/ - [L]
  RewriteCond %{REQUEST_URI} \.(?:png|jpe?g|webp|gif|svg|ico|css|js|map|txt|xml|pdf)$ [NC]
  RewriteRule . - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
